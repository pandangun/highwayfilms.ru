# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev server logs (webpack/turbopack/codex runs)
*.log
*.err
*.out

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/public/video/*
/public/images/frames/*

# Keep video sources out of git, but allow the tracked poster for the homepage hero.
!/public/video/derived/
/public/video/derived/*
!/public/video/derived/hero-poster.jpg

# Section reels are small (1–6 MB each) and ship with the site.
# The showreel itself stays in Vercel Blob (NEXT_PUBLIC_HERO_VIDEO_*_URL).
!/public/video/commercials/
!/public/video/corporate/
!/public/video/music-videos/
!/public/video/weddings/
!/public/video/videoproduction/
!/public/video/about/
!/public/video/ai/
/public/video/ai/*
!/public/video/ai/ai-01.mp4
!/public/video/ai/ai-01-mobile.mp4

# --- allow image frames & map preview in the repo ---
!/public/images/frames/**
!/public/map-preview.jpg

.vercel
.codex/
.env*.local

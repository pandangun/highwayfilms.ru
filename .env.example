NEXT_PUBLIC_SITE_URL=https://highway-films.ru
NEXT_PUBLIC_HERO_VIDEO_VERSION=20260330
NEXT_PUBLIC_HERO_VIDEO_MODE=auto
# Optional remote override for hero video. If omitted, the site uses /public/video/derived files.
# NEXT_PUBLIC_HERO_VIDEO_DESKTOP_URL=https://your-cdn.example.com/highway-films/hero-desktop.mp4
# NEXT_PUBLIC_HERO_VIDEO_MOBILE_URL=https://your-cdn.example.com/highway-films/hero-mobile.mp4

# ── Кабинет клиента ──
# База: на сервере — Postgres. Для работы на своём компьютере вместо неё
# CABINET_LOCAL_DB=1 (PGlite в папке .cabinet-data).
# DATABASE_URL=postgres://cabinet:ПАРОЛЬ@localhost:5432/cabinet
# CABINET_LOCAL_DB=1
# Ключ подписи сессий и ссылок, 48+ случайных символов: openssl rand -base64 48
CABINET_SECRET=
# Адрес сайта для ссылок, которые уходят паре и в Telegram.
CABINET_BASE_URL=https://highway-films.ru
# Хэш пароля студии: npm run cabinet:password
STUDIO_PASSWORD_HASH=
# Уведомления студии: токен бота от @BotFather и id чата, куда писать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
